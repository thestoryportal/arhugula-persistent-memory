<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rhu.memit-gdrive-backup</string>
    <!-- Install only after review. This direct bash launcher needs macOS access
         to Removable Volumes; the old MemitBackup.app's grant does not transfer.
         Deploy the reviewed script to this main-checkout path before activation. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Volumes/memit/llm-database-poc-mirror/arhugula-persistent-memory/tools/backup_gdrive.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>21600</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/robertrhu/Library/Logs/memit-gdrive-backup.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/robertrhu/Library/Logs/memit-gdrive-backup.launchd.log</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
