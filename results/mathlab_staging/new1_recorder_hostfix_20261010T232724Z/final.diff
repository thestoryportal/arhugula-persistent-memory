+    def test_recorder_absolute_executables_exist(self):
+        source = (SOURCE/"tools/new1_dispatch.sh").read_text()
+        executables = set(re.findall(r"(?<![\w$])/(?:[\w.+-]+/)*(?:s?bin)/[\w.+-]+", source))
+        self.assertTrue(executables)
+        for executable in sorted(executables):
+            with self.subTest(executable=executable):
+                self.assertTrue(Path(executable).is_file(), "missing executable: "+executable)
+                self.assertTrue(os.access(executable, os.X_OK), "not executable: "+executable)
+
+    def shell_component(self, body, df_output=None, env=None):
+        # Execute actual recorder sections; no admission, ps, supervisor or worker.
+        temp = tempfile.TemporaryDirectory(prefix="new1-shell-check-", dir="/private/tmp")
+        self.addCleanup(temp.cleanup)
+        root = Path(temp.name)
+        (root/"tools").mkdir()
+        (root/"dispatch").mkdir()
+        source = (SOURCE/"tools/new1_dispatch.sh").read_text()
+        prefix = source[:source.index("if (( $# != 3 ))")]
+        script = root/"tools/check_under_test.sh"
+        script.write_text(prefix+body)
+        if df_output is not None: (root/"df_fixture.txt").write_text(df_output)
+        provenance(root, self._testMethodName+"_"+root.name)
+        result = subprocess.run(["/bin/zsh", "-f", str(script)], cwd=root,
+                                env=dict(os.environ, **(env or {})), capture_output=True, text=True, timeout=5)
+        return result, root
+
+    def disk_component(self, df_output=None, env=None):
+        source = (SOURCE/"tools/new1_dispatch.sh").read_text()
+        definitions = source[source.index("save_check() {"):source.index("# 2b:")]
+        check = source[source.index("save_check 2f "):source.index("\nsave_check 2g ")]
+        if df_output is not None:
+            check = check.replace('save_check 2f /bin/df -k "$ROOT"',
+                                  'save_check 2f /bin/cat "$PWD/df_fixture.txt"')
+        return self.shell_component('DISPATCH="$PWD/dispatch"\n'+definitions+check, df_output, env)
+
+    def test_recorder_utc_has_complete_timestamp(self):
+        result, _ = self.shell_component("utc\n")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stderr, "")
+        self.assertRegex(result.stdout, r"^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d+Z$")
+
+    def test_recorder_disk_reads_real_df_stdout(self):
+        result, root = self.disk_component()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        disk = json.loads((root/"dispatch/disk.json").read_text())
+        check = json.loads((root/"dispatch/2f.json").read_text())
+        self.assertEqual(check["exit"], 0)
+        self.assertEqual(disk["available_kib"], int(check["stdout"].splitlines()[-1].split()[3]))
+        self.assertEqual(disk["minimum_kib"], 22020096)
+        self.assertGreaterEqual(disk["available_kib"], disk["minimum_kib"])
+
+    def test_recorder_disk_exact_floor_with_trailing_newline(self):
+        output = "Filesystem 1024-blocks Used Available Capacity Mounted on\nfixture 30000000 1 22020096 1% /fixture\n"
+        result, root = self.disk_component(output)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(json.loads((root/"dispatch/disk.json").read_text())["available_kib"], 22020096)
+        self.assertEqual(json.loads((root/"dispatch/2f.json").read_text())["stdout"], output)
+
+    def test_recorder_disk_shortage_refuses(self):
+        result, root = self.disk_component("Filesystem 1024-blocks Used Available Capacity Mounted on\nfixture 30000000 1 22020095 1% /fixture\n")
+        self.assertEqual(result.returncode, 3, result.stderr)
+        refusal = root/"dispatch/refused_before_invocation.json"
+        self.assertTrue(refusal.is_file(), result.stderr)
+        self.assertEqual(json.loads(refusal.read_text())["check"], "2f")
+        self.assertFalse(json.loads(refusal.read_text())["authorization_consumed"])
+        self.assertFalse((root/"dispatch/disk.json").exists())
+
+    def test_recorder_disk_invalid_observation_refuses(self):
+        for output in ("", "Filesystem 1024-blocks Used Available Capacity Mounted on\n",
+                       "Filesystem 1024-blocks Used Available Capacity Mounted on\nfixture 30000000 1 unknown 1% /fixture\n"):
+            with self.subTest(output=output):
+                result, root = self.disk_component(output)
+                self.assertEqual(result.returncode, 3, result.stderr)
+                refusal = root/"dispatch/refused_before_invocation.json"
+                self.assertTrue(refusal.is_file(), result.stderr)
+                self.assertEqual(json.loads(refusal.read_text())["check"], "2f")
+                self.assertFalse(json.loads(refusal.read_text())["authorization_consumed"])
+                self.assertFalse((root/"dispatch/disk.json").exists())
+
+    def test_recorder_disk_invalid_or_lowered_floor_refuses(self):
+        output = "Filesystem 1024-blocks Used Available Capacity Mounted on\nfixture 30000000 1 30000000 1% /fixture\n"
+        for floor in ("1", "invalid"):
+            with self.subTest(floor=floor):
+                result, root = self.disk_component(output, {"NEW1_DISPATCH_MIN_FREE_KIB": floor})
+                self.assertEqual(result.returncode, 3, result.stderr)
+                refusal = root/"dispatch/refused_before_invocation.json"
+                self.assertTrue(refusal.is_file(), result.stderr)
+                self.assertEqual(json.loads(refusal.read_text())["check"], "2f")
+                self.assertFalse((root/"dispatch/disk.json").exists())
+
+    def test_recorder_disk_raised_floor_refuses(self):
+        output = "Filesystem 1024-blocks Used Available Capacity Mounted on\nfixture 30000000 1 30000000 1% /fixture\n"
+        result, root = self.disk_component(output, {"NEW1_DISPATCH_MIN_FREE_KIB": str(1 << 50)})
+        self.assertEqual(result.returncode, 3, result.stderr)
+        refusal = root/"dispatch/refused_before_invocation.json"
+        self.assertTrue(refusal.is_file(), result.stderr)
+        self.assertEqual(json.loads(refusal.read_text())["check"], "2f")
+        self.assertFalse((root/"dispatch/disk.json").exists())
+
 
