        "kind": {
          "anyOf": [
            {
              "const": "file"
            },
            {
              "const": "symlink"
            },
            {
              "const": "socket"
            }
          ]
        },
        "bytes": {
          "$ref": "#/$defs/int"
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        },
        "link_text": {
          "anyOf": [
            {
              "$ref": "#/$defs/str"
            },
            {
              "type": "null"
            }
          ]
        },
        "device": {
          "$ref": "#/$defs/int"
        },
        "inode": {
          "$ref": "#/$defs/int"
        },
        "nlink": {
          "$ref": "#/$defs/int"
        }
      },
      "required": [
        "source",
        "kind",
        "bytes",
        "sha256",
        "link_text",
        "device",
        "inode",
        "nlink"
      ],
      "additionalProperties": false
    },
    "RetentionManifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "leaves": {
          "$ref": "#/$defs/Binding"
        },
        "routes": {
          "$ref": "#/$defs/Binding"
        },
        "repairs": {
          "$ref": "#/$defs/Binding"
        },
        "metadata": {
          "$ref": "#/$defs/Binding"
        },
        "executor": {
          "$ref": "#/$defs/Binding"
        },
        "containers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContainerExpectation"
          }
        }
      },
      "required": [
        "schema_version",
        "leaves",
        "routes",
        "repairs",
        "metadata",
        "executor",
        "containers"
      ],
      "additionalProperties": false
    },
    "MetadataSet": {
      "type": "object",
      "properties": {
        "schema_version": {
