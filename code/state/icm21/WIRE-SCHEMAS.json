        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "before_sha256": {
          "$ref": "#/$defs/sha"
        },
        "after_sha256": {
          "$ref": "#/$defs/sha"
        },
        "plan": {
          "$ref": "#/$defs/Binding"
        },
        "receipt": {
          "$ref": "#/$defs/Binding"
        }
      },
      "required": [
        "operation_id",
        "path",
        "before_sha256",
        "after_sha256",
        "plan",
        "receipt"
      ],
      "additionalProperties": false
    },
    "ExecutorEvidence": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OperationEvidence"
          }
        }
      },
      "required": [
        "schema_version",
        "operations"
      ],
      "additionalProperties": false
    },
    "OperationEvidence": {
      "type": "object",
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/id"
        },
        "prd_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PrdId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "plan": {
          "$ref": "#/$defs/Binding"
        },
        "approval": {
          "$ref": "#/$defs/Binding"
        },
        "journal": {
          "$ref": "#/$defs/Binding"
        },
        "verification": {
          "anyOf": [
            {
              "$ref": "#/$defs/Binding"
            },
            {
              "type": "null"
            }
          ]
        },
        "readers": {
          "anyOf": [
            {
              "$ref": "#/$defs/Binding"
            },
            {
              "type": "null"
            }
          ]
        },
        "acceptance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Binding"
            },
            {
              "type": "null"
            }
          ]
        },
        "rollback": {
          "anyOf": [
            {
              "$ref": "#/$defs/Binding"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operation_id",
        "prd_ids",
        "plan",
        "approval",
        "journal",
        "verification",
        "readers",
        "acceptance",
        "rollback"
      ],
      "additionalProperties": false
    },
    "StageReceipt": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "operation_id": {
          "$ref": "#/$defs/id"
        },
        "plan": {
          "$ref": "#/$defs/Binding"
        },
        "approval": {
          "$ref": "#/$defs/Binding"
        },
        "repository": {
          "$ref": "#/$defs/path"
        },
        "head": {
          "$ref": "#/$defs/str"
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relpath"
          }
        },
        "index_before_sha256": {
          "$ref": "#/$defs/sha"
        },
        "index_after_sha256": {
          "$ref": "#/$defs/sha"
        },
        "result": {
          "$ref": "#/$defs/CheckResult"
        }
      },
      "required": [
        "schema_version",
        "operation_id",
        "plan",
        "approval",
        "repository",
        "head",
        "paths",
        "index_before_sha256",
        "index_after_sha256",
        "result"
      ],
      "additionalProperties": false
    },
    "ReferenceRow": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "prd_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PrdId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "consumer": {
          "$ref": "#/$defs/relpath"
        },
        "consumer_sha256": {
          "$ref": "#/$defs/sha"
        },
        "consumer_final": {
          "$ref": "#/$defs/relpath"
        },
        "reference": {
          "$ref": "#/$defs/str"
        },
        "intermediate": {
          "$ref": "#/$defs/str"
        },
        "final_target": {
          "$ref": "#/$defs/str"
        },
        "role": {
          "anyOf": [
            {
              "const": "current-reader"
            },
            {
              "const": "historical-source"
            },
            {
              "const": "sealed-map"
            },
            {
              "const": "sealed-anchor"
            }
          ]
